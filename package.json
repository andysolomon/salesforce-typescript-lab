{
  "name": "salesforce-typescript-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Learning lab for JavaScript types, TypeScript, and Lightning Web Components.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/jsdoc-check/tsconfig.json",
    "typecheck:lwc": "tsc --noEmit -p tsconfig.json",
    "typecheck:jsdoc": "tsc --noEmit -p examples/jsdoc-check/tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build-lwc.mjs",
    "lint": "eslint \"**/lwc/**/*.{js,ts}\"",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,mjs,ts,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,mjs,ts,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-syntax-decorators": "^7.27.0",
    "@babel/plugin-transform-typescript": "^7.27.0",
    "@eslint/js": "^9.0.0",
    "@lwc/compiler": "8.28.2",
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.19.1"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,mjs,ts,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.{js,ts}": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
